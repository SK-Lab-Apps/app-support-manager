{
  "name": "@appsupportkit/support-sdk",
  "version": "0.4.3",
  "description": "In-app customer support for React Native: feedback, feature requests, and bug reports with two-way threads, in the user's own language.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./src/index.tsx",
  "source": "./src/index.tsx",
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepublishOnly": "bob build"
  },
  "keywords": [
    "react-native",
    "support",
    "feedback",
    "in-app"
  ],
  "license": "MIT",
  "dependencies": {
    "@appsupportkit/design-tokens": "workspace:^"
  },
  "peerDependencies": {
    "expo-notifications": ">=0.27.0",
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "expo-notifications": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-builder-bob": "^0.35.2",
    "react-native-safe-area-context": "^5.4.0",
    "typescript": "^5.7.2"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
